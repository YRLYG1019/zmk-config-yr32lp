/*
 * yr32lp  (Waveshare RP2040-Zero / PIM447 trackball / WS2812 x30)
 * QMK版 (qmk用) の info.json / config.h / mcuconf.h と同じピン配置
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &yr32lp_layout;
        zmk,underglow = &ws2812;
    };

    /* QMK の LAYOUT() と同じ並び (左5+右5 / 左5+右5 / 左5+親指2+右5) */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <11>;
        rows = <3>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)                   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)                   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(0,10) RC(1,10) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
        >;
    };

    yr32lp_layout: yr32lp_layout {
        compatible = "zmk,physical-layout";
        display-name = "yr32lp";
        transform = <&default_transform>;
        keys
            = <&key_physical_attrs 100 100    0   0 0 0 0>
            , <&key_physical_attrs 100 100  100   0 0 0 0>
            , <&key_physical_attrs 100 100  200   0 0 0 0>
            , <&key_physical_attrs 100 100  300   0 0 0 0>
            , <&key_physical_attrs 100 100  400   0 0 0 0>
            , <&key_physical_attrs 100 100  775   0 0 0 0>
            , <&key_physical_attrs 100 100  875   0 0 0 0>
            , <&key_physical_attrs 100 100  975   0 0 0 0>
            , <&key_physical_attrs 100 100 1075   0 0 0 0>
            , <&key_physical_attrs 100 100 1175   0 0 0 0>
            , <&key_physical_attrs 100 100    0 100 0 0 0>
            , <&key_physical_attrs 100 100  100 100 0 0 0>
            , <&key_physical_attrs 100 100  200 100 0 0 0>
            , <&key_physical_attrs 100 100  300 100 0 0 0>
            , <&key_physical_attrs 100 100  400 100 0 0 0>
            , <&key_physical_attrs 100 100  775 100 0 0 0>
            , <&key_physical_attrs 100 100  875 100 0 0 0>
            , <&key_physical_attrs 100 100  975 100 0 0 0>
            , <&key_physical_attrs 100 100 1075 100 0 0 0>
            , <&key_physical_attrs 100 100 1175 100 0 0 0>
            , <&key_physical_attrs 100 100    0 200 0 0 0>
            , <&key_physical_attrs 100 100  100 200 0 0 0>
            , <&key_physical_attrs 100 100  200 200 0 0 0>
            , <&key_physical_attrs 100 100  300 200 0 0 0>
            , <&key_physical_attrs 100 100  400 200 0 0 0>
            , <&key_physical_attrs 100 100  525 200 0 0 0>
            , <&key_physical_attrs 100 100  650 200 0 0 0>
            , <&key_physical_attrs 100 100  775 200 0 0 0>
            , <&key_physical_attrs 100 100  875 200 0 0 0>
            , <&key_physical_attrs 100 100  975 200 0 0 0>
            , <&key_physical_attrs 100 100 1075 200 0 0 0>
            , <&key_physical_attrs 100 100 1175 200 0 0 0>
            ;
    };

    /* diode_direction = COL2ROW (QMK と同じ) */
    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        col-gpios
            = <&gpio0 27 GPIO_ACTIVE_HIGH>
            , <&gpio0 26 GPIO_ACTIVE_HIGH>
            , <&gpio0 15 GPIO_ACTIVE_HIGH>
            , <&gpio0 14 GPIO_ACTIVE_HIGH>
            , <&gpio0 13 GPIO_ACTIVE_HIGH>
            , <&gpio0 12 GPIO_ACTIVE_HIGH>
            , <&gpio0 4  GPIO_ACTIVE_HIGH>
            , <&gpio0 5  GPIO_ACTIVE_HIGH>
            , <&gpio0 6  GPIO_ACTIVE_HIGH>
            , <&gpio0 7  GPIO_ACTIVE_HIGH>
            , <&gpio0 8  GPIO_ACTIVE_HIGH>
            ;

        row-gpios
            = <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    /* トラックボール → マウスカーソル/左クリック */
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
    };
};

/* ---- 列ピンと競合するボード標準の周辺機能を無効化 ----
 * spi0: GP3/GP4/GP6, adc: GP26/GP27, i2c0: GP24/GP25 */
&spi0 { status = "disabled"; };
&adc  { status = "disabled"; };
&i2c0 { status = "disabled"; };

/* ---- PIM447: I2C1  SDA=GP2 / SCL=GP3 (QMK: I2C1_SDA_PIN GP2 / I2C1_SCL_PIN GP3) ---- */
&i2c1_default {
    group1 {
        pinmux = <I2C1_SDA_P2>;
        input-enable;
    };
    group2 {
        pinmux = <I2C1_SCL_P3>;
        input-enable;
    };
};

&i2c1 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;

    trackball: trackball@a {
        compatible = "pimoroni,pim447";
        reg = <0x0a>;
        /* 速度: 最大 (QMK の CPI 上限 65535 と同じ速さ = QMK 版 SCALE 2 の約4倍)
         * 速すぎるときは数字を下げる (QMK 版と同じ速さは 2) */
        /* QMK: POINTING_DEVICE_ROTATION_270 */
        scale = <8>;
        rotation = <270>;
        poll-interval-ms = <10>;
    };
};

/* ---- WS2812 x30 : GP0 (PIO0)  ※RP2040-Zero 基板上の GP16 LED の代わりに使う ---- */
&ws2812_pio0_default {
    ws2812 {
        pinmux = <PIO0_P0>;
    };
};

&ws2812 {
    gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
    chain-length = <30>;
};
